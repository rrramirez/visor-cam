// Visor's look: a dark, quiet chrome with one red accent for recording.

export global Theme {
    out property <color> bg: #141518;
    out property <color> surface: #1d1f23;
    out property <color> surface-2: #272a30;
    out property <color> surface-3: #32363d;
    out property <color> border: #353940;
    out property <color> text: #eceef2;
    out property <color> muted: #9aa0ab;
    out property <color> faint: #6b717c;
    out property <color> record: #ff4d5e;
    out property <color> record-dark: #d93a4a;
    out property <color> accent: #5b9cff;
    out property <color> warning: #f6b74a;
    out property <color> success: #3ccf7f;
    out property <length> radius: 10px;
    out property <length> radius-small: 6px;
    out property <length> font-small: 11px;
    out property <length> font: 13px;
    out property <length> font-large: 15px;
}

// Stroke icons on a 24x24 grid.
export global Icons {
    out property <string> record: "M 12 4 A 8 8 0 1 1 11.99 4 Z";
    out property <string> pause: "M 7 5 L 10 5 L 10 19 L 7 19 Z M 14 5 L 17 5 L 17 19 L 14 19 Z";
    out property <string> play: "M 8 5 L 19 12 L 8 19 Z";
    out property <string> stop: "M 6 6 L 18 6 L 18 18 L 6 18 Z";
    out property <string> trash: "M 4 7 L 20 7 M 10 11 L 10 17 M 14 11 L 14 17 M 6 7 L 7 20 L 17 20 L 18 7 M 9 7 L 9 4 L 15 4 L 15 7";
    out property <string> mic: "M 12 3 C 10.3 3 9 4.3 9 6 L 9 12 C 9 13.7 10.3 15 12 15 C 13.7 15 15 13.7 15 12 L 15 6 C 15 4.3 13.7 3 12 3 Z M 5 11 C 5 15 8 18 12 18 C 16 18 19 15 19 11 M 12 18 L 12 21";
    out property <string> camera: "M 3 7 L 15 7 L 15 17 L 3 17 Z M 15 10.5 L 21 7.5 L 21 16.5 L 15 13.5";
    out property <string> speaker: "M 4 9 L 8 9 L 13 5 L 13 19 L 8 15 L 4 15 Z M 16 9 C 17.5 10.5 17.5 13.5 16 15 M 18.5 6.5 C 21.5 9.5 21.5 14.5 18.5 17.5";
    out property <string> monitor: "M 3 4 L 21 4 L 21 16 L 3 16 Z M 8 20 L 16 20 M 12 16 L 12 20";
    out property <string> window: "M 3 5 L 21 5 L 21 19 L 3 19 Z M 3 9 L 21 9";
    out property <string> apps: "M 4 4 L 10 4 L 10 10 L 4 10 Z M 14 4 L 20 4 L 20 10 L 14 10 Z M 4 14 L 10 14 L 10 20 L 4 20 Z M 14 14 L 20 14 L 20 20 L 14 20 Z";
    out property <string> area: "M 4 9 L 4 4 L 9 4 M 15 4 L 20 4 L 20 9 M 20 15 L 20 20 L 15 20 M 9 20 L 4 20 L 4 15";
    out property <string> folder: "M 3 6 L 9 6 L 11 8 L 21 8 L 21 19 L 3 19 Z";
    out property <string> settings: "M 4 7 L 20 7 M 4 17 L 20 17 M 9 4 L 9 10 M 15 14 L 15 20";
    out property <string> scissors: "M 9 6 A 3 3 0 1 1 3 6 A 3 3 0 1 1 9 6 Z M 9 18 A 3 3 0 1 1 3 18 A 3 3 0 1 1 9 18 Z M 8.5 7.5 L 20 18 M 8.5 16.5 L 20 6";
    out property <string> trim: "M 8 4 L 4 4 L 4 20 L 8 20 M 16 4 L 20 4 L 20 20 L 16 20";
    out property <string> undo: "M 9 14 L 4 9 L 9 4 M 4 9 L 15 9 C 18 9 20 11 20 14 C 20 17 18 19 15 19 L 11 19";
    out property <string> redo: "M 15 14 L 20 9 L 15 4 M 20 9 L 9 9 C 6 9 4 11 4 14 C 4 17 6 19 9 19 L 13 19";
    out property <string> restore: "M 4 4 L 4 9 L 9 9 M 4.5 9 C 6 5.5 9 4 12 4 C 16.4 4 20 7.6 20 12 C 20 16.4 16.4 20 12 20 C 8.5 20 5.5 17.8 4.5 14.5";
    out property <string> export: "M 12 3 L 12 15 M 7 8 L 12 3 L 17 8 M 5 14 L 5 20 L 19 20 L 19 14";
    out property <string> close: "M 6 6 L 18 18 M 18 6 L 6 18";
    out property <string> check: "M 5 12 L 10 17 L 19 7";
    out property <string> chevron-down: "M 6 9 L 12 15 L 18 9";
    out property <string> chevron-right: "M 9 6 L 15 12 L 9 18";
    out property <string> copy: "M 9 9 L 20 9 L 20 20 L 9 20 Z M 15 9 L 15 4 L 4 4 L 4 15 L 9 15";
    out property <string> open: "M 14 4 L 20 4 L 20 10 M 20 4 L 11 13 M 18 14 L 18 20 L 4 20 L 4 6 L 10 6";
    out property <string> refresh: "M 20 4 L 20 9 L 15 9 M 19.5 9 C 18 5.5 15 4 12 4 C 7.6 4 4 7.6 4 12 C 4 16.4 7.6 20 12 20 C 15.5 20 18.5 17.8 19.5 14.5";
}

export component Glyph inherits Path {
    in property <string> icon;
    in property <color> color: Theme.text;
    in property <bool> filled: false;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: icon;
    stroke: filled ? transparent : color;
    stroke-width: filled ? 0 : 1.8px;
    fill: filled ? color : transparent;
}
