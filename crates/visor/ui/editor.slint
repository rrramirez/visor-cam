import { ComboBox, Switch, Slider, ProgressIndicator, ScrollView, LineEdit } from "std-widgets.slint";
import { Theme, Glyph, Icons } from "theme.slint";
import { IconButton, PillButton, SectionLabel, Card, CollapsibleSection } from "widgets.slint";

// The timeline shows the whole recording, clip by clip in the order they
// play, each with what was deleted next to it, dimmed. Positions on it are
// fractions (0..1) of it.

// A clip: where it plays, where it is with what was deleted next to it
// (which moves with it), where its part of the recording starts (as a
// fraction of the recording), and how long it is.
export struct Clip {
    start: float,
    end: float,
    block-start: float,
    block-end: float,
    src-start: float,
    label: string,
}

// The part of blur `blur` that plays at a stretch of the timeline.
export struct BlurBand {
    blur: int,
    start: float,
    end: float,
}

// A marker, at a timeline position: its time in the video, its text, and
// both together.
export struct MarkerMark {
    pos: float,
    time: string,
    text: string,
    label: string,
}

// A blurred area: where it starts and ends on the timeline (-1 if that's
// cut), and when it is in the video.
export struct BlurRow {
    start: float,
    end: float,
    time: string,
}

// A stretch deleted from the recording: where it is on the timeline, where
// it starts in the recording (a fraction of it), the clip it would come
// back at, and how long it is.
export struct Gone {
    start: float,
    end: float,
    src-start: float,
    clip: int,
    label: string,
}

// A time on the ruler.
export struct Tick {
    pos: float,
    label: string,
}

export struct Thumb {
    image: image,
    start: float,
    end: float,
}

component SideButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> shortcut;
    in property <bool> enabled: true;
    callback clicked;
    height: 34px;
    border-radius: Theme.radius-small;
    background: !enabled ? transparent : t.pressed ? Theme.surface-3 : t.has-hover ? Theme.surface-2 : transparent;
    opacity: enabled ? 1 : 0.4;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        Glyph {
            y: (parent.height - self.height) / 2;
            icon: root.icon;
            width: 16px;
            height: 16px;
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            color: Theme.text;
        }
        Text {
            text: root.shortcut;
            vertical-alignment: center;
            horizontal-alignment: right;
            color: Theme.faint;
            font-size: Theme.font-small;
        }
    }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// An item of the *Add video…* menu.
component AddMenuRow inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 30px;
    border-radius: Theme.radius-small;
    background: t.has-hover ? Theme.surface-3 : transparent;
    Text {
        x: 8px;
        width: parent.width - 16px;
        text: root.text;
        color: Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One edge of a clip or a blur on the timeline: drag it to move it, or
// click it to pick it for nudging. With `inside`, its grip lies inside what
// it bounds, so it can be grabbed at either end of the timeline; else
// mostly outside, so a narrow stretch's two edges don't cover each other.
component CutEdge inherits Rectangle {
    // Where the edge is, as a fraction of `track-width`.
    in property <float> pos;
    in property <length> track-width;
    in property <bool> end;
    in property <bool> inside;
    in property <bool> active;
    in property <color> line: Theme.record;
    callback grab();
    // The fraction under the pointer, keeping where it was grabbed.
    callback drag(float);
    // Whether it was dragged, and whether it ended up moved.
    callback release(bool, bool);
    callback cancel();
    property <length> edge: end != inside ? 2px : 8px;
    x: pos * track-width - edge;
    width: 10px;
    Rectangle {
        x: parent.edge - self.width / 2;
        width: active ? 4px : 2px;
        border-radius: 1px;
        background: active ? Theme.accent : root.line;
    }
    TouchArea {
        property <bool> dragged;
        // Where it was pressed, on the track (this moves with the edge).
        property <length> pressed-at;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                self.dragged = false;
                self.pressed-at = root.x + self.mouse-x;
                root.grab();
            }
            // Brought back to where it was grabbed: not moved after all.
            if (event.kind == PointerEventKind.up) {
                root.release(self.dragged, self.dragged && abs(root.x + self.mouse-x - self.pressed-at) >= 1px);
            }
            if (event.kind == PointerEventKind.cancel) { root.cancel(); }
        }
        moved => {
            // A click that wobbles isn't a drag, as on the timeline.
            if (abs(self.mouse-x - self.pressed-x) > 4px) { self.dragged = true; }
            if (self.dragged) {
                root.drag((root.x + root.edge + self.mouse-x - self.pressed-x) / root.track-width);
            }
        }
    }
}

export component Editor inherits Window {
    title: "Visor — " + root.project-title;
    preferred-width: 1180px;
    preferred-height: 800px;
    min-width: 860px;
    min-height: 620px;
    background: Theme.bg;
    default-font-size: Theme.font;

    in-out property <string> project-title;
    in property <image> screen;
    in property <float> screen-aspect: 16 / 9;
    in property <image> camera;
    in property <bool> has-camera;
    // False in a take recorded without the camera.
    in property <bool> camera-shown: true;
    in-out property <bool> bubble-visible: true;
    // 0 circle, 1 rounded square
    in-out property <int> bubble-shape;
    // Normalized to the screen frame: top-left and width.
    in-out property <float> bubble-x: 0.03;
    in-out property <float> bubble-y: 0.75;
    in-out property <float> bubble-size: 0.2;
    // Selfie view, as the live bubble showed it while recording.
    in-out property <bool> bubble-mirror: true;
    // Playback and export speed, 0.5–2.0.
    in-out property <float> speed: 1.0;
    in property <string> speed-label;
    // Which sidebar sections are unfolded.
    in-out property <bool> edit-open: true;
    in-out property <bool> camera-open: true;
    in-out property <bool> speed-open: true;
    in-out property <bool> thumbnail-open: true;
    in-out property <bool> markers-open: true;
    in-out property <bool> blur-open: true;
    // The marker whose name field takes the keyboard when it shows up.
    in-out property <int> focus-marker: -1;
    // The marker add-marker() just added.
    in property <int> new-marker: -1;
    // Added with M, to name once the key is let go (so it doesn't repeat
    // into the name).
    property <int> pending-marker: -1;
    // Thumbnail position on the timeline, or -1 for the first frame kept.
    in property <float> thumbnail-pos: -1;
    in property <string> thumbnail-label;
    // A thumbnail image is being saved; its outcome when it failed.
    in property <bool> saving-thumbnail;
    in property <string> thumbnail-error;

    in property <bool> playing;
    in property <float> position;
    in property <string> time-label;
    in property <[Clip]> clips;
    // The clip edge picked for nudging with ← →: clip index * 2, + 1 for
    // its end; -1 for none.
    in-out property <int> active-edge: -1;
    // A clip edge being dragged (clip index, which end) and where it is.
    // Set to -1 when the clips change, which ends the drag.
    in-out property <int> drag-clip: -1;
    property <bool> drag-end;
    property <float> drag-pos;
    // A clip being moved, where the pointer is, and the slot it would go
    // to (before that clip; the clip count for last). Set to -1 when the
    // clips change, which ends the move.
    in-out property <int> moving-clip: -1;
    property <float> moving-pos;
    property <int> moving-slot;
    // Where a dragged clip would go, given the timeline position under the
    // pointer: before the clip of that index.
    pure callback clip-slot(float) -> int;
    // Where the moved clip is drawn (its start), and where in it it was
    // grabbed, as timeline fractions.
    property <float> moving-x;
    property <float> moving-grab;
    // A moved clip moves with what was deleted next to it: its block.
    property <float> moving-len: root.moving-clip >= 0 ? root.clips[root.moving-clip].block-end - root.clips[root.moving-clip].block-start : 0;
    // Where the moved block would start once let go, the others closed up
    // behind it.
    property <float> landing: root.landing-at();
    pure function landing-at() -> float {
        if (root.moving-clip < 0) { return 0; }
        if (root.moving-slot >= root.clips.length) { return 1 - root.moving-len; }
        let at = root.clips[root.moving-slot].block-start;
        return root.moving-slot > root.moving-clip ? at - root.moving-len : at;
    }
    // How far clip `j`'s block shows from where it is: the moved one under
    // the pointer, and the others sliding out of its way.
    pure function shift(j: int) -> float {
        if (root.moving-clip < 0 || j < 0 || j >= root.clips.length) { return 0; }
        let s = root.clips[j].block-start;
        if (j == root.moving-clip) { return root.moving-x - s; }
        let closed = s > root.clips[root.moving-clip].block-start ? s - root.moving-len : s;
        return (closed >= root.landing ? closed + root.moving-len : closed) - s;
    }
    in property <[Gone]> removed;
    in property <[Tick]> ticks;
    // Puts back deleted stretch `removed[i]`.
    callback bring-back(int);

    function grab-edge(clip: int, end: bool, pos: float) {
        root.drag-clip = clip;
        root.drag-end = end;
        root.drag-pos = pos;
    }
    function drag-edge(pos: float) {
        root.drag-pos = pos;
        root.preview(root.drag-clip, pos, root.drag-end);
    }
    // Picks the edge, and moves it there if it was dragged.
    function release-edge(clip: int, end: bool, dragged: bool, moved: bool) {
        if (root.drag-clip != clip) { return; }
        root.drag-clip = -1;
        root.active-edge = end ? clip * 2 + 1 : clip * 2;
        root.blur-edge = -1;
        if (moved) {
            root.clip-edge-moved(clip, end, root.drag-pos);
        } else if (dragged) {
            root.drag-ended();
        }
        keys.focus();
    }
    function grab-blur-edge(edge: int, pos: float) {
        root.drag-blur-edge = edge;
        root.drag-blur-pos = pos;
    }
    function drag-blur(pos: float) {
        root.drag-blur-pos = pos;
        root.blur-edge-dragged(root.drag-blur-edge == 1, pos);
    }
    // Picks the edge, and moves it there if it was dragged.
    function release-blur-edge(end: bool, moved: bool) {
        if (root.drag-blur-edge < 0) { return; }
        root.drag-blur-edge = -1;
        root.active-edge = -1;
        root.blur-edge = end ? 1 : 0;
        if (moved) {
            root.blur-edge-moved(end, root.drag-blur-pos);
        } else {
            root.show-blur-edge(end);
        }
        keys.focus();
    }
    function cancel-blur-edge() {
        if (root.drag-blur-edge < 0) { return; }
        let end = root.drag-blur-edge == 1;
        root.drag-blur-edge = -1;
        root.blur-edge = end ? 1 : 0;
        root.show-blur-edge(end);
    }
    // Moves the corner of the picked blur's box on that side to the
    // pointer (normalized), keeping the opposite corner where it is.
    function resize-blur(right: bool, bottom: bool, px: float, py: float) {
        if (right) {
            root.blur-w = max(root.min-blur, min(1 - root.blur-x, px - root.blur-x));
        } else {
            let r = root.blur-x + root.blur-w;
            let left = max(0, min(r - root.min-blur, px));
            root.blur-x = left;
            root.blur-w = r - left;
        }
        if (bottom) {
            root.blur-h = max(root.min-blur, min(1 - root.blur-y, py - root.blur-y));
        } else {
            let b = root.blur-y + root.blur-h;
            let top = max(0, min(b - root.min-blur, py));
            root.blur-y = top;
            root.blur-h = b - top;
        }
        root.blur-moved(false);
    }

    function cancel-edge() {
        root.drag-clip = -1;
        root.drag-ended();
    }
    // The picked blur's edge picked for nudging with ← →: 0 its start, 1
    // its end, -1 none; and the one being dragged, and where it is.
    in-out property <int> blur-edge: -1;
    property <int> drag-blur-edge: -1;
    property <float> drag-blur-pos;
    in property <[MarkerMark]> markers;
    in property <[BlurRow]> blurs;
    in property <[BlurBand]> blur-bands;
    // The blur whose box shows on the video, to move and resize, or -1;
    // and its area, normalized to the frame, as it is dragged.
    in-out property <int> picked-blur: -1;
    in-out property <float> blur-x;
    in-out property <float> blur-y;
    in-out property <float> blur-w;
    in-out property <float> blur-h;
    property <float> min-blur: 0.02;
    in-out property <float> sel-start: -1;
    in-out property <float> sel-end: -1;
    property <bool> has-selection: sel-start >= 0 && sel-end > sel-start;
    in property <[Thumb]> thumbs;
    in property <string> wave-path;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> edited;
    in property <string> kept-label;

    in-out property <int> export-format;
    in-out property <int> export-resolution;
    in property <bool> has-audio;
    in-out property <bool> export-denoise;
    in-out property <bool> export-normalize;
    in property <bool> exporting;
    in property <float> export-progress;
    in property <string> export-status;
    in property <bool> export-done;
    // Shown when an export finishes: what was made and what to do with it.
    in-out property <bool> export-card;
    in property <string> export-name;
    in property <string> export-detail;
    in property <string> file-manager: "Finder";
    in property <bool> can-copy;
    in property <bool> copied;

    callback toggle-play();
    callback seek(float);
    // Shows a frame even inside a cut.
    callback preview(int, float, bool);
    callback drag-ended();
    callback clip-edge-moved(int, bool, float);
    callback nudge-edge(int, bool);
    // Cuts the clip under the playhead in two there.
    callback cut-at-playhead();
    // Moves a clip to play before another (the clip count for last).
    callback move-clip(int, int);
    // Selects the whole of a clip.
    callback select-clip(int);
    callback selection-changed(float, float);
    callback set-in();
    callback set-out();
    callback delete-selection();
    callback trim-to-selection();
    // Looks for stretches where nothing happens and removes them.
    callback remove-pauses();
    callback record-more();
    // Adding videos: the recent recordings the menu offers (by name), and
    // while files are copied in, what to say on the button.
    in property <[string]> recent-recordings;
    in property <bool> adding;
    in property <string> adding-label;
    in property <string> add-error;
    callback open-add-menu();
    callback add-recent(int);
    callback add-files();
    callback add-recording();
    callback add-marker();
    callback rename-marker(int, string);
    callback delete-marker(int);
    callback add-blur();
    callback pick-blur(int);
    callback delete-blur(int);
    callback blur-to-selection(int);
    // The picked blur's box moved; true once let go.
    callback blur-moved(bool);
    // An edge of the picked blur (true for its end): dragged to a timeline
    // position, let go there, picked without moving, or nudged by frames.
    callback blur-edge-dragged(bool, float);
    callback blur-edge-moved(bool, float);
    callback show-blur-edge(bool);
    callback nudge-blur-edge(int, bool);
    in property <bool> finding-pauses;
    callback restore();
    callback undo();
    callback redo();
    callback step(int);
    callback bubble-changed();
    callback speed-changed();
    callback sections-changed();
    callback title-edited(string);
    // Puts the cursor in the name field with the name selected, so typing
    // replaces it (a fresh recording's editor starts there).
    public function focus-name() {
        name-edit.focus();
        name-edit.select-all();
    }
    callback set-thumbnail();
    callback reset-thumbnail();
    callback save-thumbnail();
    callback export();
    callback cancel-export();
    callback reveal-export();
    callback reveal-project();
    callback open-export();
    callback copy-export();
    callback done();

    forward-focus: keys;
    keys := FocusScope {
        key-released(event) => {
            if (root.pending-marker >= 0) {
                root.focus-marker = root.pending-marker;
                root.pending-marker = -1;
            }
            reject
        }
        key-pressed(event) => {
            if (event.text == " ") { root.toggle-play(); return accept; }
            if (event.text == "i") { root.set-in(); return accept; }
            if (event.text == "o") { root.set-out(); return accept; }
            if (event.text == "t") { root.trim-to-selection(); return accept; }
            if ((event.text == "r" || event.text == "R") && !event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt) {
                if (!event.repeat && !root.exporting && !root.finding-pauses && !root.adding) { root.record-more(); }
                return accept;
            }
            // C, or ⌘B as in other editors (B alone blurs).
            if ((event.text == "c" || event.text == "C") && !event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt) {
                if (!event.repeat) { root.cut-at-playhead(); }
                return accept;
            }
            if ((event.text == "b" || event.text == "B") && (event.modifiers.control || event.modifiers.meta) && !event.modifiers.alt) {
                if (!event.repeat) { root.cut-at-playhead(); }
                return accept;
            }
            if ((event.text == "m" || event.text == "M") && !event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt) {
                if (!event.repeat) {
                    root.add-marker();
                    root.pending-marker = root.new-marker;
                }
                return accept;
            }
            if ((event.text == "b" || event.text == "B") && !event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt) {
                if (!event.repeat) { root.add-blur(); }
                return accept;
            }
            if (event.text == Key.Backspace || event.text == Key.Delete) { root.delete-selection(); return accept; }
            if (event.text == Key.LeftArrow && root.blur-edge >= 0) { root.nudge-blur-edge(event.modifiers.shift ? -10 : -1, event.repeat); return accept; }
            if (event.text == Key.RightArrow && root.blur-edge >= 0) { root.nudge-blur-edge(event.modifiers.shift ? 10 : 1, event.repeat); return accept; }
            if (event.text == Key.LeftArrow && root.active-edge >= 0) { root.nudge-edge(event.modifiers.shift ? -10 : -1, event.repeat); return accept; }
            if (event.text == Key.RightArrow && root.active-edge >= 0) { root.nudge-edge(event.modifiers.shift ? 10 : 1, event.repeat); return accept; }
            if (event.text == Key.LeftArrow) { root.step(event.modifiers.shift ? -10 : -1); return accept; }
            if (event.text == Key.RightArrow) { root.step(event.modifiers.shift ? 10 : 1); return accept; }
            if (event.text == Key.Escape && root.export-card) {
                root.export-card = false;
                return accept;
            }
            if (root.export-card) { return reject; }
            if (event.text == Key.Escape && root.blur-edge >= 0) {
                root.blur-edge = -1;
                return accept;
            }
            if (event.text == Key.Escape && root.picked-blur >= 0) {
                root.pick-blur(-1);
                return accept;
            }
            if (event.text == Key.Escape && root.moving-clip >= 0) {
                root.moving-clip = -1;
                return accept;
            }
            if (event.text == Key.Escape && root.active-edge >= 0) {
                root.active-edge = -1;
                return accept;
            }
            if (event.text == Key.Escape) {
                root.sel-start = -1;
                root.sel-end = -1;
                root.selection-changed(-1, -1);
                return accept;
            }
            if ((event.modifiers.meta || event.modifiers.control) && (event.text == "z" || event.text == "Z")) {
                if (event.modifiers.shift) { root.redo(); } else { root.undo(); }
                return accept;
            }
            reject
        }
    }

    VerticalLayout {
        // Top bar
        Rectangle {
            height: 52px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                spacing: 10px;
                Rectangle {
                    width: 22px;
                    Rectangle { width: 12px; height: 12px; border-radius: 6px; background: Theme.record; }
                }
                Text {
                    text: root.project-title;
                    color: Theme.text;
                    font-size: Theme.font-large;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                IconButton {
                    icon: Icons.folder;
                    tooltip: "Show recording folder";
                    clicked => { root.reveal-project(); }
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            // Preview
            preview-area := Rectangle {
                horizontal-stretch: 1;
                background: #0d0e10;
                property <length> avail-w: self.width - 48px;
                property <length> avail-h: self.height - 48px;
                property <length> frame-w: min(avail-w, avail-h * root.screen-aspect);
                property <length> frame-h: frame-w / root.screen-aspect;

                frame := Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: preview-area.frame-w;
                    height: preview-area.frame-h;
                    background: black;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: #00000080;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.screen;
                        image-fit: contain;
                    }
                    TouchArea {
                        clicked => { root.toggle-play(); keys.focus(); }
                    }

                    if root.has-camera && root.camera-shown && root.bubble-visible: bubble := Rectangle {
                        property <length> size: parent.width * root.bubble-size;
                        x: max(0, min(parent.width - self.size, parent.width * root.bubble-x));
                        y: max(0, min(parent.height - self.size, parent.height * root.bubble-y));
                        width: self.size;
                        height: self.size;
                        border-radius: root.bubble-shape == 0 ? self.size / 2 : self.size * 0.18;
                        clip: true;
                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.camera;
                            image-fit: cover;
                            transform-scale-x: root.bubble-mirror ? -1 : 1;
                        }
                        Rectangle {
                            border-radius: parent.border-radius;
                            border-width: bubble-touch.has-hover ? 2px : 0;
                            border-color: Theme.accent;
                        }
                        bubble-touch := TouchArea {
                            mouse-cursor: move;
                            moved => {
                                root.bubble-x = max(0, min(1 - bubble.size / frame.width,
                                    (bubble.x + self.mouse-x - self.pressed-x) / frame.width));
                                root.bubble-y = max(0, min(1 - bubble.size / frame.height,
                                    (bubble.y + self.mouse-y - self.pressed-y) / frame.height));
                            }
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.up) { root.bubble-changed(); }
                            }
                        }
                    }

                    // The picked blur: drag it to move it, or a corner to
                    // resize it. Hidden while playing.
                    if root.picked-blur >= 0 && !root.playing: blur-box := Rectangle {
                        x: parent.width * root.blur-x;
                        y: parent.height * root.blur-y;
                        width: parent.width * root.blur-w;
                        height: parent.height * root.blur-h;
                        border-width: 2px;
                        border-radius: 4px;
                        border-color: Theme.warning;
                        TouchArea {
                            mouse-cursor: move;
                            moved => {
                                root.blur-x = max(0, min(1 - root.blur-w,
                                    (blur-box.x + self.mouse-x - self.pressed-x) / frame.width));
                                root.blur-y = max(0, min(1 - root.blur-h,
                                    (blur-box.y + self.mouse-y - self.pressed-y) / frame.height));
                                root.blur-moved(false);
                            }
                            // Kept where it was dragged to, even if the
                            // drag is cut short.
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) { root.blur-moved(true); }
                            }
                        }
                        for corner in [0, 1, 2, 3]: Rectangle {
                            property <bool> right: corner == 1 || corner == 3;
                            property <bool> bottom: corner >= 2;
                            x: (self.right ? parent.width : 0) - self.width / 2;
                            y: (self.bottom ? parent.height : 0) - self.height / 2;
                            width: 12px;
                            height: 12px;
                            border-radius: 2px;
                            background: Theme.warning;
                            TouchArea {
                                mouse-cursor: parent.right == parent.bottom ? nwse-resize : nesw-resize;
                                moved => {
                                    // Where the corner's centre goes, in the frame.
                                    root.resize-blur(parent.right, parent.bottom,
                                        (blur-box.x + parent.x + self.mouse-x - self.pressed-x + parent.width / 2) / frame.width,
                                        (blur-box.y + parent.y + self.mouse-y - self.pressed-y + parent.height / 2) / frame.height);
                                }
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) { root.blur-moved(true); }
                                }
                            }
                        }
                    }
                }
            }

            // Sidebar: sections scroll; Export stays at the bottom.
            Rectangle {
                width: 268px;
                background: Theme.surface;
                VerticalLayout {
                    sidebar-scroll := ScrollView {
                        vertical-stretch: 1;
                        viewport-width: self.visible-width;
                        viewport-height: sections.preferred-height;
                        sections := VerticalLayout {
                            width: sidebar-scroll.visible-width;
                            height: self.preferred-height;
                            padding: 14px;
                            spacing: 14px;

                            VerticalLayout {
                                spacing: 8px;
                                SectionLabel { text: "NAME"; }
                                name-edit := LineEdit {
                                    text: root.project-title;
                                    placeholder-text: "Name this recording";
                                    edited(text) => { root.title-edited(text); }
                                    // Enter hands the keyboard back to the editor.
                                    accepted => { keys.focus(); }
                                    // Leaving it blank keeps the last name.
                                    changed has-focus => {
                                        if (!self.has-focus) { self.text = root.project-title; }
                                    }
                                }
                                Text {
                                    text: "Exports are named after it.";
                                    color: Theme.faint;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                }
                            }

                            CollapsibleSection {
                                title: "EDIT";
                                open <=> root.edit-open;
                                toggled => { root.sections-changed(); }
                                VerticalLayout {
                                    spacing: 2px;
                                    SideButton {
                                        text: "Set in point"; icon: Icons.trim; shortcut: "I";
                                        clicked => { root.set-in(); keys.focus(); }
                                    }
                                    SideButton {
                                        text: "Set out point"; icon: Icons.trim; shortcut: "O";
                                        clicked => { root.set-out(); keys.focus(); }
                                    }
                                    SideButton {
                                        text: "Cut at playhead"; icon: Icons.scissors; shortcut: "C";
                                        clicked => { root.cut-at-playhead(); keys.focus(); }
                                    }
                                    SideButton {
                                        text: "Delete selection"; icon: Icons.trash; shortcut: "⌫";
                                        enabled: root.has-selection;
                                        clicked => { root.delete-selection(); keys.focus(); }
                                    }
                                    SideButton {
                                        text: "Trim to selection"; icon: Icons.area; shortcut: "T";
                                        enabled: root.has-selection;
                                        clicked => { root.trim-to-selection(); keys.focus(); }
                                    }
                                    SideButton {
                                        text: root.finding-pauses ? "Finding pauses…" : "Remove pauses"; icon: Icons.skip;
                                        enabled: !root.finding-pauses && !root.adding;
                                        clicked => { root.remove-pauses(); keys.focus(); }
                                    }
                                    SideButton {
                                        text: "Record more"; icon: Icons.record; shortcut: "R";
                                        enabled: !root.exporting && !root.finding-pauses && !root.adding;
                                        clicked => { root.record-more(); keys.focus(); }
                                    }
                                    add-button := SideButton {
                                        text: root.adding ? root.adding-label : "Add video…"; icon: Icons.plus;
                                        enabled: !root.exporting && !root.finding-pauses && !root.adding;
                                        clicked => {
                                            root.open-add-menu();
                                            add-menu.show();
                                        }
                                        add-menu := PopupWindow {
                                            x: 0;
                                            y: parent.height + 2px;
                                            width: parent.width;
                                            close-policy: close-on-click;
                                            Rectangle {
                                                background: Theme.surface-2;
                                                border-radius: Theme.radius-small;
                                                border-width: 1px;
                                                border-color: Theme.surface-3;
                                                VerticalLayout {
                                                    padding: 4px;
                                                    spacing: 0;
                                                    if root.recent-recordings.length > 0: Text {
                                                        text: "Recent recordings";
                                                        color: Theme.faint;
                                                        font-size: Theme.font-small;
                                                        height: 22px;
                                                        vertical-alignment: center;
                                                        x: 8px;
                                                    }
                                                    for name[i] in root.recent-recordings: AddMenuRow {
                                                        text: name;
                                                        clicked => { root.add-recent(i); keys.focus(); }
                                                    }
                                                    if root.recent-recordings.length > 0: Rectangle {
                                                        height: 1px;
                                                        background: Theme.surface-3;
                                                    }
                                                    AddMenuRow {
                                                        text: "Choose video files…";
                                                        clicked => { root.add-files(); keys.focus(); }
                                                    }
                                                    AddMenuRow {
                                                        text: "Choose a Visor recording…";
                                                        clicked => { root.add-recording(); keys.focus(); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if root.add-error != "": Text {
                                        text: root.add-error;
                                        color: Theme.record;
                                        font-size: Theme.font-small;
                                        wrap: word-wrap;
                                    }
                                    SideButton {
                                        text: "Undo"; icon: Icons.undo; shortcut: "⌘Z";
                                        enabled: root.can-undo;
                                        clicked => { root.undo(); keys.focus(); }
                                    }
                                    SideButton {
                                        text: "Redo"; icon: Icons.redo; shortcut: "⇧⌘Z";
                                        enabled: root.can-redo;
                                        clicked => { root.redo(); keys.focus(); }
                                    }
                                    SideButton {
                                        text: "Restore the whole recording"; icon: Icons.restore;
                                        enabled: root.edited;
                                        clicked => { root.restore(); keys.focus(); }
                                    }
                                }
                                Text {
                                    text: root.kept-label;
                                    color: Theme.faint;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                }
                            }

                            CollapsibleSection {
                                title: "MARKERS";
                                open <=> root.markers-open;
                                toggled => { root.sections-changed(); }
                                SideButton {
                                    text: "Add marker"; icon: Icons.marker; shortcut: "M";
                                    clicked => {
                                        root.add-marker();
                                        root.focus-marker = root.new-marker;
                                    }
                                }
                                for m[i] in root.markers: HorizontalLayout {
                                    spacing: 6px;
                                    Rectangle {
                                        width: max(48px, time.preferred-width + 8px);
                                        border-radius: Theme.radius-small;
                                        background: time-touch.has-hover ? Theme.surface-2 : transparent;
                                        time := Text {
                                            text: m.time;
                                            color: Theme.muted;
                                            font-size: Theme.font-small;
                                        }
                                        time-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { if (m.pos >= 0) { root.seek(m.pos); } keys.focus(); }
                                        }
                                    }
                                    LineEdit {
                                        text: m.text;
                                        placeholder-text: "Name it";
                                        edited(text) => { root.rename-marker(i, text); }
                                        accepted => { keys.focus(); }
                                        property <bool> wanted: root.focus-marker == i;
                                        init => { self.take-focus(); }
                                        changed wanted => { self.take-focus(); }
                                        function take-focus() {
                                            if (self.wanted) {
                                                root.focus-marker = -1;
                                                self.focus();
                                            }
                                        }
                                    }
                                    IconButton {
                                        size: 30px;
                                        icon: Icons.trash;
                                        tint: Theme.muted;
                                        tooltip: "Delete marker";
                                        clicked => { root.delete-marker(i); keys.focus(); }
                                    }
                                }
                                Text {
                                    text: "Marks a step: MP4 and WebM exports get a chapter at each one, named after it.";
                                    color: Theme.faint;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                }
                            }

                            CollapsibleSection {
                                title: "BLUR";
                                open <=> root.blur-open;
                                toggled => { root.sections-changed(); }
                                SideButton {
                                    text: "Blur an area"; icon: Icons.blur; shortcut: "B";
                                    clicked => { root.add-blur(); keys.focus(); }
                                }
                                for b[i] in root.blurs: HorizontalLayout {
                                    spacing: 6px;
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 30px;
                                        border-radius: Theme.radius-small;
                                        background: root.picked-blur == i ? Theme.surface-3
                                            : blur-touch.has-hover ? Theme.surface-2 : transparent;
                                        border-width: root.picked-blur == i ? 1px : 0;
                                        border-color: Theme.warning;
                                        Text {
                                            x: 8px;
                                            text: b.time;
                                            color: Theme.text;
                                            font-size: Theme.font-small;
                                            vertical-alignment: center;
                                        }
                                        blur-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.pick-blur(i); keys.focus(); }
                                        }
                                    }
                                    IconButton {
                                        size: 30px;
                                        icon: Icons.trash;
                                        tint: Theme.muted;
                                        tooltip: "Delete blur";
                                        clicked => { root.delete-blur(i); keys.focus(); }
                                    }
                                }
                                // When the picked blur shows: limit it to the selection,
                                // or how to make one.
                                if root.picked-blur >= 0 && root.has-selection: SideButton {
                                    text: "Blur only during the selection"; icon: Icons.trim;
                                    clicked => { root.blur-to-selection(root.picked-blur); keys.focus(); }
                                }
                                Text {
                                    text: root.blurs.length == 0
                                        ? "Hides part of the screen, like a password. To blur only part of the video, first drag on the timeline to select that part; otherwise it covers the whole video."
                                        : root.picked-blur < 0
                                        ? "Click a blur to move or resize it on the video."
                                        : "Drag the box on the video to place it, and its corners to resize it. To change when it shows, drag its edges on the timeline, or click one and press ← → to move it a frame at a time.";
                                    color: Theme.faint;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                }
                            }

                            if root.has-camera: CollapsibleSection {
                                title: "CAMERA BUBBLE";
                                open <=> root.camera-open;
                                toggled => { root.sections-changed(); }
                                Switch {
                                    text: "Show camera";
                                    checked <=> root.bubble-visible;
                                    toggled => { root.bubble-changed(); }
                                }
                                Switch {
                                    text: "Mirror camera";
                                    checked <=> root.bubble-mirror;
                                    toggled => { root.bubble-changed(); }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    PillButton {
                                        text: "Circle";
                                        primary: root.bubble-shape == 0;
                                        clicked => { root.bubble-shape = 0; root.bubble-changed(); }
                                    }
                                    PillButton {
                                        text: "Rounded";
                                        primary: root.bubble-shape == 1;
                                        clicked => { root.bubble-shape = 1; root.bubble-changed(); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "Size"; color: Theme.muted; vertical-alignment: center; }
                                    Slider {
                                        minimum: 0.08;
                                        maximum: 0.45;
                                        value <=> root.bubble-size;
                                        released => { root.bubble-changed(); }
                                    }
                                }
                            }

                            CollapsibleSection {
                                title: "SPEED";
                                open <=> root.speed-open;
                                toggled => { root.sections-changed(); }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Slider {
                                        minimum: 0.5;
                                        maximum: 2.0;
                                        value <=> root.speed;
                                        // Snap to 0.05 steps.
                                        changed(v) => { root.speed = round(v * 20) / 20; }
                                        released => { root.speed-changed(); }
                                    }
                                    Text {
                                        width: 44px;
                                        text: (round(root.speed * 100) / 100) + "×";
                                        color: root.speed == 1 ? Theme.muted : Theme.text;
                                        font-weight: 600;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: root.speed-label;
                                        color: Theme.faint;
                                        font-size: Theme.font-small;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                    }
                                    if root.speed != 1: PillButton {
                                        horizontal-stretch: 0;
                                        text: "Reset";
                                        font-size: Theme.font-small;
                                        clicked => { root.speed = 1; root.speed-changed(); }
                                    }
                                }
                            }

                            CollapsibleSection {
                                title: "THUMBNAIL";
                                open <=> root.thumbnail-open;
                                toggled => { root.sections-changed(); }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: root.thumbnail-label;
                                        color: Theme.muted;
                                        vertical-alignment: center;
                                    }
                                    if root.thumbnail-pos >= 0: PillButton {
                                        horizontal-stretch: 0;
                                        text: "Reset";
                                        font-size: Theme.font-small;
                                        clicked => { root.reset-thumbnail(); keys.focus(); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    PillButton {
                                        text: "Use frame";
                                        icon: Icons.image;
                                        clicked => { root.set-thumbnail(); keys.focus(); }
                                    }
                                    PillButton {
                                        text: root.saving-thumbnail ? "Saving…" : "Save image";
                                        icon: Icons.export;
                                        enabled: !root.saving-thumbnail;
                                        clicked => { root.save-thumbnail(); keys.focus(); }
                                    }
                                }
                                if root.thumbnail-error != "": Text {
                                    text: root.thumbnail-error;
                                    color: Theme.record;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "MP4 exports carry it as their cover, shown by " + root.file-manager + " and players. Save image writes it as a JPEG.";
                                    color: Theme.faint;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border; }
                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;
                        SectionLabel { text: "EXPORT"; }
                        ComboBox {
                            model: ["MP4 (H.264)", "WebM (VP9)", "WebM (AV1)", "GIF"];
                            current-index <=> root.export-format;
                            enabled: !root.exporting;
                        }
                        ComboBox {
                            model: ["Original size", "1080p", "720p"];
                            current-index <=> root.export-resolution;
                            enabled: !root.exporting && root.export-format != 3;
                        }
                        if root.has-audio && root.export-format != 3: Switch {
                            text: "Reduce background noise";
                            checked <=> root.export-denoise;
                            enabled: !root.exporting;
                        }
                        if root.has-audio && root.export-format != 3: Switch {
                            text: "Even out volume";
                            checked <=> root.export-normalize;
                            enabled: !root.exporting;
                        }
                        if root.exporting: VerticalLayout {
                            spacing: 6px;
                            ProgressIndicator { progress: root.export-progress; }
                            HorizontalLayout {
                                Text { text: root.export-status; color: Theme.muted; font-size: Theme.font-small; vertical-alignment: center; }
                                PillButton { text: "Cancel"; clicked => { root.cancel-export(); } }
                            }
                        }
                        if !root.exporting: PillButton {
                            primary: true;
                            text: "Export";
                            icon: Icons.export;
                            enabled: !root.adding;
                            clicked => { root.export(); }
                        }
                        if !root.exporting && root.export-status != "": HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: root.export-status;
                                color: root.export-done ? Theme.success : Theme.record;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                                vertical-alignment: center;
                            }
                            if root.export-done: PillButton {
                                text: "Show";
                                clicked => { root.reveal-export(); }
                            }
                        }
                    }
                }
            }
        }

        // Transport
        Rectangle {
            height: 48px;
            background: Theme.surface;
            border-width: 0;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                IconButton {
                    y: (parent.height - self.height) / 2;
                    size: 36px;
                    icon: root.playing ? Icons.pause : Icons.play;
                    filled: true;
                    tooltip: "Play / pause (Space)";
                    clicked => { root.toggle-play(); keys.focus(); }
                }
                Text {
                    text: root.time-label;
                    color: Theme.text;
                    font-family: "Menlo";
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.active-edge >= 0 || root.blur-edge >= 0
                        ? "← → move this edge a frame (⇧ for 10) · Esc to stop"
                        : "Drag the ruler to select · Drag a clip to move it, an edge to trim it · C cuts · Hover a dimmed part to bring it back";
                    color: Theme.faint;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
            }
        }

        // Timeline: a ruler to select on, and the clips below it.
        timeline := Rectangle {
            height: 150px;
            background: Theme.bg;
            property <length> track-x: 14px;
            property <length> track-w: self.width - 28px;

            track := Rectangle {
                x: timeline.track-x;
                y: 12px;
                width: timeline.track-w;
                height: parent.height - 24px;
                border-radius: Theme.radius-small;
                clip: true;
                background: Theme.surface;
                property <length> ruler: 18px;

                // Drag along the ruler to select; click it to go there.
                Rectangle {
                    height: track.ruler;
                    y: 0;
                    background: Theme.surface-2;
                }
                for t in root.ticks: Rectangle {
                    x: t.pos * track.width;
                    y: 0;
                    width: 40px;
                    height: track.ruler;
                    Rectangle {
                        x: 0;
                        y: parent.height - 5px;
                        width: 1px;
                        height: 5px;
                        background: Theme.faint;
                    }
                    Text {
                        x: 3px;
                        y: 1px;
                        text: t.label;
                        color: Theme.faint;
                        font-size: 9px;
                    }
                }
                ruler-touch := TouchArea {
                    y: 0;
                    height: track.ruler;
                    mouse-cursor: pointer;
                    property <bool> dragging;
                    property <float> anchor;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            self.dragging = false;
                            self.anchor = max(0, min(1, self.mouse-x / track.width));
                            root.active-edge = -1;
                            root.blur-edge = -1;
                        }
                        if (event.kind == PointerEventKind.up && !self.dragging) {
                            root.sel-start = -1;
                            root.sel-end = -1;
                            root.selection-changed(-1, -1);
                            root.seek(self.anchor);
                            keys.focus();
                        }
                        if (event.kind == PointerEventKind.up && self.dragging) {
                            root.selection-changed(root.sel-start, root.sel-end);
                            keys.focus();
                        }
                    }
                    moved => {
                        if (abs(self.mouse-x - self.pressed-x) > 4px) { self.dragging = true; }
                        if (self.dragging) {
                            root.sel-start = min(self.anchor, max(0, min(1, self.mouse-x / track.width)));
                            root.sel-end = max(self.anchor, max(0, min(1, self.mouse-x / track.width)));
                        }
                    }
                }

                // Where a moved clip would go.
                if root.moving-clip >= 0: Rectangle {
                    x: root.landing * track.width;
                    y: track.ruler;
                    width: root.moving-len * track.width;
                    height: track.height - track.ruler;
                    background: Theme.accent.transparentize(80%);
                    border-width: 2px;
                    border-color: Theme.accent;
                }

                // Each clip shows its part of the recording's thumbnails and
                // waveform, drawn at the recording's length and shifted. Drag
                // one to move it (the others make room), or click it to
                // select it.
                for c[i] in root.clips: Rectangle {
                    property <bool> moving: root.moving-clip == i;
                    property <length> content-w: track.width;
                    property <length> content-x: -c.src-start * self.content-w;
                    // A gap from the clip before.
                    property <length> gap: c.start > 0 && !self.moving ? 2px : 0;
                    x: (c.start + root.shift(i)) * track.width + self.gap;
                    y: track.ruler;
                    z: self.moving ? 1 : 0;
                    width: max(0px, (c.end - c.start) * track.width - self.gap);
                    height: track.height - track.ruler;
                    clip: true;
                    background: Theme.surface;
                    border-width: self.moving ? 2px : 0;
                    border-color: Theme.accent;
                    opacity: self.moving ? 0.9 : 1;
                    Rectangle {
                        y: 0;
                        height: 14px;
                        background: clip-touch.has-hover || parent.moving ? Theme.surface-3 : Theme.surface-2;
                        Text {
                            x: 6px;
                            text: c.label;
                            color: Theme.muted;
                            font-size: 10px;
                            vertical-alignment: center;
                            visible: parent.width > self.preferred-width + 12px;
                        }
                    }
                    for t in root.thumbs: Image {
                        x: parent.content-x - parent.gap + t.start * parent.content-w;
                        y: 16px;
                        width: (t.end - t.start) * parent.content-w;
                        height: 46px;
                        source: t.image;
                        image-fit: cover;
                        opacity: 0.85;
                    }
                    Path {
                        x: parent.content-x - parent.gap;
                        y: 64px;
                        width: parent.content-w;
                        height: parent.height - 66px;
                        viewbox-width: 1000;
                        viewbox-height: 100;
                        // Stretched to the clip, not kept in proportion.
                        fit: fill;
                        commands: root.wave-path;
                        fill: #5b9cff66;
                        stroke: transparent;
                    }
                    clip-touch := TouchArea {
                        mouse-cursor: root.clips.length > 1 ? (parent.moving ? grabbing : grab) : pointer;
                        property <bool> dragged;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                self.dragged = false;
                                root.active-edge = -1;
                                root.blur-edge = -1;
                            }
                            if (event.kind == PointerEventKind.up) {
                                if (self.dragged && parent.moving) {
                                    root.moving-clip = -1;
                                    root.move-clip(i, root.moving-slot);
                                } else if (!self.dragged) {
                                    root.seek(max(0, min(1, (parent.x + self.mouse-x) / track.width)));
                                    root.select-clip(i);
                                }
                                keys.focus();
                            }
                            if (event.kind == PointerEventKind.cancel) { root.moving-clip = -1; }
                        }
                        moved => {
                            if (root.clips.length > 1 && !self.dragged && abs(self.mouse-x - self.pressed-x) > 4px) {
                                self.dragged = true;
                                root.moving-grab = c.start - c.block-start + (self.pressed-x + parent.gap) / track.width;
                                root.moving-x = c.block-start;
                                root.moving-slot = i;
                                root.moving-clip = i;
                            }
                            if (self.dragged && parent.moving) {
                                root.moving-x = max(0, min(1 - root.moving-len, (parent.x + self.mouse-x) / track.width - root.moving-grab));
                                root.moving-slot = root.clip-slot(root.moving-x + root.moving-len / 2);
                            }
                        }
                    }
                }

                // What was deleted, dimmed by the clip it would come back at
                // (it moves with it). Hover it to bring it back; click it to
                // go to what plays after it.
                for g[k] in root.removed: gone := Rectangle {
                    property <bool> open: (gone-touch.has-hover || card-touch.has-hover) && root.moving-clip < 0 && root.drag-clip < 0;
                    property <length> card-w: 132px;
                    x: (g.start + root.shift(g.clip)) * track.width;
                    y: track.ruler;
                    z: self.open ? 2 : (root.moving-clip == g.clip ? 1 : 0);
                    width: (g.end - g.start) * track.width;
                    height: track.height - track.ruler;
                    Rectangle {
                        clip: true;
                        background: Theme.bg;
                        for t in root.thumbs: Image {
                            x: -g.src-start * track.width + t.start * track.width;
                            y: 16px;
                            width: (t.end - t.start) * track.width;
                            height: 46px;
                            source: t.image;
                            image-fit: cover;
                            opacity: 0.25;
                        }
                        Rectangle {
                            y: 0;
                            height: 14px;
                            background: gone.open ? Theme.surface-3 : transparent;
                        }
                    }
                    gone-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.seek(max(0, min(1, (gone.x + self.mouse-x) / track.width)));
                            keys.focus();
                        }
                    }
                    // What it was, and a button to bring it back.
                    Rectangle {
                        visible: gone.open;
                        x: max(0px, min(track.width - gone.card-w, gone.x + gone.width / 2 - gone.card-w / 2)) - gone.x;
                        y: 18px;
                        width: gone.card-w;
                        height: 52px;
                        border-radius: 6px;
                        background: #141518f2;
                        card-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.bring-back(k);
                                keys.focus();
                            }
                        }
                        Text {
                            x: 8px;
                            y: 5px;
                            text: g.label;
                            color: Theme.muted;
                            font-size: Theme.font-small;
                        }
                        Rectangle {
                            x: 6px;
                            y: 25px;
                            width: parent.width - 12px;
                            height: 21px;
                            border-radius: 4px;
                            background: card-touch.has-hover ? Theme.accent : Theme.surface-3;
                            Text {
                                text: "Bring back";
                                color: Theme.text;
                                font-size: Theme.font-small;
                            }
                        }
                    }
                }

                // Blurred stretches: bands along the bottom, stacked so
                // overlapping ones show.
                for b in root.blur-bands: Rectangle {
                    property <bool> picked: root.picked-blur == b.blur;
                    visible: root.moving-clip < 0;
                    x: b.start * track.width;
                    y: track.height - 5px - mod(b.blur, 3) * 7px;
                    width: max(2px, (b.end - b.start) * track.width);
                    height: 5px;
                    background: self.picked ? Theme.warning : Theme.warning.transparentize(50%);
                }

                if root.has-selection: Rectangle {
                    x: root.sel-start * track.width;
                    width: (root.sel-end - root.sel-start) * track.width;
                    height: track.height;
                    background: #5b9cff33;
                    border-width: 2px;
                    border-color: Theme.accent;
                }

                // Selection edge handles.
                if root.has-selection: Rectangle {
                    x: root.sel-start * track.width - 5px;
                    width: 10px;
                    height: track.height;
                    Rectangle { width: 4px; height: 28px; border-radius: 2px; background: Theme.accent; }
                    TouchArea {
                        mouse-cursor: ew-resize;
                        moved => {
                            root.sel-start = max(0, min(root.sel-end - 0.001, (parent.x + self.mouse-x) / track.width));
                        }
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.up) { root.selection-changed(root.sel-start, root.sel-end); }
                        }
                    }
                }
                if root.has-selection: Rectangle {
                    x: root.sel-end * track.width - 5px;
                    width: 10px;
                    height: track.height;
                    Rectangle { width: 4px; height: 28px; border-radius: 2px; background: Theme.accent; }
                    TouchArea {
                        mouse-cursor: ew-resize;
                        moved => {
                            root.sel-end = min(1, max(root.sel-start + 0.001, (parent.x + self.mouse-x) / track.width));
                        }
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.up) { root.selection-changed(root.sel-start, root.sel-end); }
                        }
                    }
                }

                // Clip edges: drag one to show more or less of the recording,
                // over what was deleted next to it, seeing the clip's first
                // or last frame; or click one and nudge it a frame at a time
                // with ← →.
                for c[i] in root.clips: CutEdge {
                    visible: root.moving-clip < 0;
                    y: track.ruler;
                    height: track.height - track.ruler;
                    pos: root.drag-clip == i && !root.drag-end ? max(0, root.drag-pos) : c.start;
                    track-width: track.width;
                    inside: true;
                    line: Theme.muted;
                    active: root.active-edge == i * 2;
                    grab => { root.grab-edge(i, false, c.start); }
                    drag(f) => { root.drag-edge(min(c.end, f)); }
                    release(dragged, moved) => { root.release-edge(i, false, dragged, moved); }
                    cancel => { root.cancel-edge(); }
                }
                for c[i] in root.clips: CutEdge {
                    visible: root.moving-clip < 0;
                    y: track.ruler;
                    height: track.height - track.ruler;
                    end: true;
                    pos: root.drag-clip == i && root.drag-end ? min(1, root.drag-pos) : c.end;
                    track-width: track.width;
                    inside: true;
                    line: Theme.muted;
                    active: root.active-edge == i * 2 + 1;
                    grab => { root.grab-edge(i, true, c.end); }
                    drag(f) => { root.drag-edge(max(c.start, f)); }
                    release(dragged, moved) => { root.release-edge(i, true, dragged, moved); }
                    cancel => { root.cancel-edge(); }
                }

                // The picked blur's edges: drag one to change when it starts
                // or ends, showing the first or last frame it blurs; or click
                // one and nudge it a frame at a time with ← →.
                for b[i] in root.blurs: CutEdge {
                    visible: root.picked-blur == i && b.start >= 0;
                    pos: root.drag-blur-edge == 0 ? root.drag-blur-pos : b.start;
                    track-width: track.width;
                    inside: true;
                    line: Theme.warning;
                    active: root.blur-edge == 0;
                    grab => { root.grab-blur-edge(0, b.start); }
                    // Not held to the other edge on the timeline: moved clips
                    // can play the end first. It's kept in order in the
                    // recording instead.
                    drag(f) => { root.drag-blur(max(0, min(1, f))); }
                    release(dragged, moved) => { root.release-blur-edge(false, moved); }
                    cancel => { root.cancel-blur-edge(); }
                }
                for b[i] in root.blurs: CutEdge {
                    visible: root.picked-blur == i && b.end >= 0;
                    end: true;
                    pos: root.drag-blur-edge == 1 ? root.drag-blur-pos : b.end;
                    track-width: track.width;
                    inside: true;
                    line: Theme.warning;
                    active: root.blur-edge == 1;
                    grab => { root.grab-blur-edge(1, b.end); }
                    drag(f) => { root.drag-blur(max(0, min(1, f))); }
                    release(dragged, moved) => { root.release-blur-edge(true, moved); }
                    cancel => { root.cancel-blur-edge(); }
                }

                // Markers: a line with a flag; hover shows the note, click seeks.
                for m in root.markers: Rectangle {
                    visible: m.pos >= 0;
                    x: m.pos * track.width - 1px;
                    width: 2px;
                    height: track.height;
                    background: Theme.accent.transparentize(40%);
                }
                for m in root.markers: Rectangle {
                    visible: m.pos >= 0;
                    x: m.pos * track.width;
                    y: 0;
                    width: 12px;
                    height: 12px;
                    background: Theme.accent;
                    flag := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { if (m.pos >= 0) { root.seek(m.pos); } keys.focus(); }
                    }
                    if flag.has-hover: Rectangle {
                        property <length> w: note.preferred-width + 12px;
                        x: min(0px, track.width - m.pos * track.width - self.w);
                        y: parent.height + 2px;
                        width: self.w;
                        height: 20px;
                        border-radius: 4px;
                        background: #141518f2;
                        note := Text {
                            text: m.label;
                            color: Theme.text;
                            font-size: Theme.font-small;
                        }
                    }
                }

                // Thumbnail frame
                if root.thumbnail-pos >= 0: Rectangle {
                    x: root.thumbnail-pos * track.width - 5px;
                    y: 2px;
                    width: 10px;
                    height: 10px;
                    border-radius: 2px;
                    background: Theme.warning;
                    transform-rotation: 45deg;
                }

                // Playhead
                Rectangle {
                    x: root.position * track.width - 1px;
                    width: 2px;
                    height: track.height;
                    background: white;
                    Rectangle {
                        y: 0;
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: white;
                    }
                }
            }
        }
    }

    // Export finished: the next steps, over the editor.
    if root.export-card: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000a8;
        // Swallow clicks so the editor underneath stays put.
        TouchArea { }

        Card {
            width: 440px;
            height: card-layout.preferred-height;
            background: Theme.surface;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000080;

            card-layout := VerticalLayout {
                padding: 28px;
                padding-top: 30px;
                spacing: 8px;
                alignment: start;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 52px;
                        height: 52px;
                        border-radius: 26px;
                        background: Theme.success.with-alpha(0.15);
                        Glyph { icon: Icons.check; color: Theme.success; width: 28px; height: 28px; }
                    }
                }
                Text {
                    text: "Your video is ready";
                    horizontal-alignment: center;
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.text;
                }
                Text {
                    text: root.export-name;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    color: Theme.text;
                }
                Text {
                    text: root.export-detail;
                    horizontal-alignment: center;
                    color: Theme.muted;
                    font-size: Theme.font-small;
                }

                Rectangle { height: 10px; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    PillButton {
                        primary: true;
                        text: "Show in " + root.file-manager;
                        icon: Icons.folder;
                        clicked => { root.reveal-export(); }
                    }
                    PillButton {
                        text: "Open";
                        icon: Icons.open;
                        clicked => { root.open-export(); }
                    }
                    if root.can-copy: PillButton {
                        text: root.copied ? "Copied" : "Copy";
                        icon: root.copied ? Icons.check : Icons.copy;
                        clicked => { root.copy-export(); }
                    }
                }
                if root.can-copy: Text {
                    text: root.copied
                        ? "Paste it into Messages, Mail, Slack or any app that takes files."
                        : "Copy puts the file on the clipboard, ready to paste into a message.";
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    color: Theme.muted;
                    font-size: Theme.font-small;
                }

                Rectangle { height: 14px; }
                Rectangle { height: 1px; background: Theme.border; }
                Rectangle { height: 6px; }
                HorizontalLayout {
                    spacing: 8px;
                    PillButton {
                        horizontal-stretch: 0;
                        text: "Keep editing";
                        clicked => { root.export-card = false; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    PillButton {
                        horizontal-stretch: 0;
                        text: "Done";
                        icon: Icons.check;
                        clicked => { root.done(); }
                    }
                }
            }
        }
    }
}
