import { ComboBox, Switch, Slider, ProgressIndicator, ScrollView, LineEdit } from "std-widgets.slint";
import { Theme, Glyph, Icons } from "theme.slint";
import { IconButton, PillButton, SectionLabel, Card, CollapsibleSection } from "widgets.slint";

// Positions on the timeline are fractions (0..1) of the source duration.
export struct Region {
    start: float,
    end: float,
}

// A note made while recording (see app::agent), at a timeline position.
export struct MarkerMark {
    pos: float,
    label: string,
}

export struct Thumb {
    image: image,
    start: float,
    end: float,
}

component SideButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> shortcut;
    in property <bool> enabled: true;
    callback clicked;
    height: 34px;
    border-radius: Theme.radius-small;
    background: !enabled ? transparent : t.pressed ? Theme.surface-3 : t.has-hover ? Theme.surface-2 : transparent;
    opacity: enabled ? 1 : 0.4;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        Glyph {
            y: (parent.height - self.height) / 2;
            icon: root.icon;
            width: 16px;
            height: 16px;
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            color: Theme.text;
        }
        Text {
            text: root.shortcut;
            vertical-alignment: center;
            horizontal-alignment: right;
            color: Theme.faint;
            font-size: Theme.font-small;
        }
    }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One edge of a cut on the timeline: drag it to move it, or click it to
// pick it for nudging. Its grip lies mostly outside the cut, so a narrow
// cut's two edges don't cover each other.
component CutEdge inherits Rectangle {
    // Where the edge is, as a fraction of `track-width`.
    in property <float> pos;
    in property <length> track-width;
    in property <bool> end;
    in property <bool> active;
    callback grab();
    // The fraction under the pointer, keeping where it was grabbed.
    callback drag(float);
    // Whether it was dragged, and whether it ended up moved.
    callback release(bool, bool);
    callback cancel();
    property <length> edge: end ? 2px : 8px;
    x: pos * track-width - edge;
    width: 10px;
    Rectangle {
        x: parent.edge - self.width / 2;
        width: active ? 4px : 2px;
        border-radius: 1px;
        background: active ? Theme.accent : Theme.record;
    }
    TouchArea {
        property <bool> dragged;
        // Where it was pressed, on the track (this moves with the edge).
        property <length> pressed-at;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                self.dragged = false;
                self.pressed-at = root.x + self.mouse-x;
                root.grab();
            }
            // Brought back to where it was grabbed: not moved after all.
            if (event.kind == PointerEventKind.up) {
                root.release(self.dragged, self.dragged && abs(root.x + self.mouse-x - self.pressed-at) >= 1px);
            }
            if (event.kind == PointerEventKind.cancel) { root.cancel(); }
        }
        moved => {
            // A click that wobbles isn't a drag, as on the timeline.
            if (abs(self.mouse-x - self.pressed-x) > 4px) { self.dragged = true; }
            if (self.dragged) {
                root.drag((root.x + root.edge + self.mouse-x - self.pressed-x) / root.track-width);
            }
        }
    }
}

export component Editor inherits Window {
    title: "Visor — " + root.project-title;
    preferred-width: 1180px;
    preferred-height: 800px;
    min-width: 860px;
    min-height: 620px;
    background: Theme.bg;
    default-font-size: Theme.font;

    in-out property <string> project-title;
    in property <image> screen;
    in property <float> screen-aspect: 16 / 9;
    in property <image> camera;
    in property <bool> has-camera;
    in-out property <bool> bubble-visible: true;
    // 0 circle, 1 rounded square
    in-out property <int> bubble-shape;
    // Normalized to the screen frame: top-left and width.
    in-out property <float> bubble-x: 0.03;
    in-out property <float> bubble-y: 0.75;
    in-out property <float> bubble-size: 0.2;
    // Selfie view, as the live bubble showed it while recording.
    in-out property <bool> bubble-mirror: true;
    // Playback and export speed, 0.5–2.0.
    in-out property <float> speed: 1.0;
    in property <string> speed-label;
    // Which sidebar sections are unfolded.
    in-out property <bool> edit-open: true;
    in-out property <bool> camera-open: true;
    in-out property <bool> speed-open: true;
    in-out property <bool> thumbnail-open: true;
    // Thumbnail position on the timeline, or -1 for the first frame kept.
    in property <float> thumbnail-pos: -1;
    in property <string> thumbnail-label;
    // A thumbnail image is being saved; its outcome when it failed.
    in property <bool> saving-thumbnail;
    in property <string> thumbnail-error;

    in property <bool> playing;
    in property <float> position;
    in property <string> time-label;
    in property <[Region]> cuts;
    // The cut edge picked for nudging with ← →: cut index * 2, + 1 for its
    // end; -1 for none.
    in-out property <int> active-edge: -1;
    // A cut edge being dragged (cut index, which end) and where it is.
    // Set to -1 when the cuts change, which ends the drag.
    in-out property <int> drag-cut: -1;
    property <bool> drag-end;
    property <float> drag-pos;

    function grab-edge(cut: int, end: bool, pos: float) {
        root.drag-cut = cut;
        root.drag-end = end;
        root.drag-pos = pos;
    }
    function drag-edge(pos: float) {
        root.drag-pos = pos;
        root.preview(root.drag-cut, pos, root.drag-end);
    }
    // Picks the edge, and moves it there if it was dragged.
    function release-edge(cut: int, end: bool, dragged: bool, moved: bool) {
        if (root.drag-cut != cut) { return; }
        root.drag-cut = -1;
        root.active-edge = end ? cut * 2 + 1 : cut * 2;
        if (moved) {
            root.cut-edge-moved(cut, end, root.drag-pos);
        } else if (dragged) {
            root.drag-ended();
        }
        keys.focus();
    }
    function cancel-edge() {
        root.drag-cut = -1;
        root.drag-ended();
    }
    in property <[MarkerMark]> markers;
    in-out property <float> sel-start: -1;
    in-out property <float> sel-end: -1;
    property <bool> has-selection: sel-start >= 0 && sel-end > sel-start;
    in property <[Thumb]> thumbs;
    in property <string> wave-path;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> edited;
    in property <string> kept-label;

    in-out property <int> export-format;
    in-out property <int> export-resolution;
    in property <bool> has-audio;
    in-out property <bool> export-denoise;
    in-out property <bool> export-normalize;
    in property <bool> exporting;
    in property <float> export-progress;
    in property <string> export-status;
    in property <bool> export-done;
    // Shown when an export finishes: what was made and what to do with it.
    in-out property <bool> export-card;
    in property <string> export-name;
    in property <string> export-detail;
    in property <string> file-manager: "Finder";
    in property <bool> can-copy;
    in property <bool> copied;

    callback toggle-play();
    callback seek(float);
    // Shows a frame even inside a cut.
    callback preview(int, float, bool);
    callback drag-ended();
    callback cut-edge-moved(int, bool, float);
    callback nudge-edge(int, bool);
    callback selection-changed(float, float);
    callback set-in();
    callback set-out();
    callback cut-selection();
    callback trim-to-selection();
    // Looks for stretches where nothing happens and cuts them.
    callback cut-pauses();
    in property <bool> finding-pauses;
    callback restore();
    callback undo();
    callback redo();
    callback step(int);
    callback bubble-changed();
    callback speed-changed();
    callback sections-changed();
    callback title-edited(string);
    // Puts the cursor in the name field with the name selected, so typing
    // replaces it (a fresh recording's editor starts there).
    public function focus-name() {
        name-edit.focus();
        name-edit.select-all();
    }
    callback set-thumbnail();
    callback reset-thumbnail();
    callback save-thumbnail();
    callback export();
    callback cancel-export();
    callback reveal-export();
    callback reveal-project();
    callback open-export();
    callback copy-export();
    callback done();

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == " ") { root.toggle-play(); return accept; }
            if (event.text == "i") { root.set-in(); return accept; }
            if (event.text == "o") { root.set-out(); return accept; }
            if (event.text == "t") { root.trim-to-selection(); return accept; }
            if (event.text == Key.Backspace || event.text == Key.Delete) { root.cut-selection(); return accept; }
            if (event.text == Key.LeftArrow && root.active-edge >= 0) { root.nudge-edge(event.modifiers.shift ? -10 : -1, event.repeat); return accept; }
            if (event.text == Key.RightArrow && root.active-edge >= 0) { root.nudge-edge(event.modifiers.shift ? 10 : 1, event.repeat); return accept; }
            if (event.text == Key.LeftArrow) { root.step(event.modifiers.shift ? -10 : -1); return accept; }
            if (event.text == Key.RightArrow) { root.step(event.modifiers.shift ? 10 : 1); return accept; }
            if (event.text == Key.Escape && root.export-card) {
                root.export-card = false;
                return accept;
            }
            if (root.export-card) { return reject; }
            if (event.text == Key.Escape && root.active-edge >= 0) {
                root.active-edge = -1;
                return accept;
            }
            if (event.text == Key.Escape) {
                root.sel-start = -1;
                root.sel-end = -1;
                root.selection-changed(-1, -1);
                return accept;
            }
            if ((event.modifiers.meta || event.modifiers.control) && (event.text == "z" || event.text == "Z")) {
                if (event.modifiers.shift) { root.redo(); } else { root.undo(); }
                return accept;
            }
            reject
        }
    }

    VerticalLayout {
        // Top bar
        Rectangle {
            height: 52px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                spacing: 10px;
                Rectangle {
                    width: 22px;
                    Rectangle { width: 12px; height: 12px; border-radius: 6px; background: Theme.record; }
                }
                Text {
                    text: root.project-title;
                    color: Theme.text;
                    font-size: Theme.font-large;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                IconButton {
                    icon: Icons.folder;
                    tooltip: "Show recording folder";
                    clicked => { root.reveal-project(); }
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            // Preview
            preview-area := Rectangle {
                horizontal-stretch: 1;
                background: #0d0e10;
                property <length> avail-w: self.width - 48px;
                property <length> avail-h: self.height - 48px;
                property <length> frame-w: min(avail-w, avail-h * root.screen-aspect);
                property <length> frame-h: frame-w / root.screen-aspect;

                frame := Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: preview-area.frame-w;
                    height: preview-area.frame-h;
                    background: black;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: #00000080;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.screen;
                        image-fit: contain;
                    }
                    TouchArea {
                        clicked => { root.toggle-play(); keys.focus(); }
                    }

                    if root.has-camera && root.bubble-visible: bubble := Rectangle {
                        property <length> size: parent.width * root.bubble-size;
                        x: max(0, min(parent.width - self.size, parent.width * root.bubble-x));
                        y: max(0, min(parent.height - self.size, parent.height * root.bubble-y));
                        width: self.size;
                        height: self.size;
                        border-radius: root.bubble-shape == 0 ? self.size / 2 : self.size * 0.18;
                        clip: true;
                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.camera;
                            image-fit: cover;
                            transform-scale-x: root.bubble-mirror ? -1 : 1;
                        }
                        Rectangle {
                            border-radius: parent.border-radius;
                            border-width: bubble-touch.has-hover ? 2px : 0;
                            border-color: Theme.accent;
                        }
                        bubble-touch := TouchArea {
                            mouse-cursor: move;
                            moved => {
                                root.bubble-x = max(0, min(1 - bubble.size / frame.width,
                                    (bubble.x + self.mouse-x - self.pressed-x) / frame.width));
                                root.bubble-y = max(0, min(1 - bubble.size / frame.height,
                                    (bubble.y + self.mouse-y - self.pressed-y) / frame.height));
                            }
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.up) { root.bubble-changed(); }
                            }
                        }
                    }
                }
            }

            // Sidebar: sections scroll; Export stays at the bottom.
            Rectangle {
                width: 268px;
                background: Theme.surface;
                VerticalLayout {
                    sidebar-scroll := ScrollView {
                        vertical-stretch: 1;
                        viewport-width: self.visible-width;
                        viewport-height: sections.preferred-height;
                        sections := VerticalLayout {
                            width: sidebar-scroll.visible-width;
                            height: self.preferred-height;
                            padding: 14px;
                            spacing: 14px;

                            VerticalLayout {
                                spacing: 8px;
                                SectionLabel { text: "NAME"; }
                                name-edit := LineEdit {
                                    text: root.project-title;
                                    placeholder-text: "Name this recording";
                                    edited(text) => { root.title-edited(text); }
                                    // Enter hands the keyboard back to the editor.
                                    accepted => { keys.focus(); }
                                    // Leaving it blank keeps the last name.
                                    changed has-focus => {
                                        if (!self.has-focus) { self.text = root.project-title; }
                                    }
                                }
                                Text {
                                    text: "Exports are named after it.";
                                    color: Theme.faint;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                }
                            }

                            CollapsibleSection {
                                title: "EDIT";
                                open <=> root.edit-open;
                                toggled => { root.sections-changed(); }
                                VerticalLayout {
                                    spacing: 2px;
                                    SideButton {
                                        text: "Set in point"; icon: Icons.trim; shortcut: "I";
                                        clicked => { root.set-in(); keys.focus(); }
                                    }
                                    SideButton {
                                        text: "Set out point"; icon: Icons.trim; shortcut: "O";
                                        clicked => { root.set-out(); keys.focus(); }
                                    }
                                    SideButton {
                                        text: "Cut selection"; icon: Icons.scissors; shortcut: "⌫";
                                        enabled: root.has-selection;
                                        clicked => { root.cut-selection(); keys.focus(); }
                                    }
                                    SideButton {
                                        text: "Trim to selection"; icon: Icons.area; shortcut: "T";
                                        enabled: root.has-selection;
                                        clicked => { root.trim-to-selection(); keys.focus(); }
                                    }
                                    SideButton {
                                        text: root.finding-pauses ? "Finding pauses…" : "Cut pauses"; icon: Icons.skip;
                                        enabled: !root.finding-pauses;
                                        clicked => { root.cut-pauses(); keys.focus(); }
                                    }
                                    SideButton {
                                        text: "Undo"; icon: Icons.undo; shortcut: "⌘Z";
                                        enabled: root.can-undo;
                                        clicked => { root.undo(); keys.focus(); }
                                    }
                                    SideButton {
                                        text: "Redo"; icon: Icons.redo; shortcut: "⇧⌘Z";
                                        enabled: root.can-redo;
                                        clicked => { root.redo(); keys.focus(); }
                                    }
                                    SideButton {
                                        text: "Restore all cuts"; icon: Icons.restore;
                                        enabled: root.edited;
                                        clicked => { root.restore(); keys.focus(); }
                                    }
                                }
                                Text {
                                    text: root.kept-label;
                                    color: Theme.faint;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                }
                            }

                            if root.has-camera: CollapsibleSection {
                                title: "CAMERA BUBBLE";
                                open <=> root.camera-open;
                                toggled => { root.sections-changed(); }
                                Switch {
                                    text: "Show camera";
                                    checked <=> root.bubble-visible;
                                    toggled => { root.bubble-changed(); }
                                }
                                Switch {
                                    text: "Mirror camera";
                                    checked <=> root.bubble-mirror;
                                    toggled => { root.bubble-changed(); }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    PillButton {
                                        text: "Circle";
                                        primary: root.bubble-shape == 0;
                                        clicked => { root.bubble-shape = 0; root.bubble-changed(); }
                                    }
                                    PillButton {
                                        text: "Rounded";
                                        primary: root.bubble-shape == 1;
                                        clicked => { root.bubble-shape = 1; root.bubble-changed(); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "Size"; color: Theme.muted; vertical-alignment: center; }
                                    Slider {
                                        minimum: 0.08;
                                        maximum: 0.45;
                                        value <=> root.bubble-size;
                                        released => { root.bubble-changed(); }
                                    }
                                }
                            }

                            CollapsibleSection {
                                title: "SPEED";
                                open <=> root.speed-open;
                                toggled => { root.sections-changed(); }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Slider {
                                        minimum: 0.5;
                                        maximum: 2.0;
                                        value <=> root.speed;
                                        // Snap to 0.05 steps.
                                        changed(v) => { root.speed = round(v * 20) / 20; }
                                        released => { root.speed-changed(); }
                                    }
                                    Text {
                                        width: 44px;
                                        text: (round(root.speed * 100) / 100) + "×";
                                        color: root.speed == 1 ? Theme.muted : Theme.text;
                                        font-weight: 600;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: root.speed-label;
                                        color: Theme.faint;
                                        font-size: Theme.font-small;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                    }
                                    if root.speed != 1: PillButton {
                                        horizontal-stretch: 0;
                                        text: "Reset";
                                        font-size: Theme.font-small;
                                        clicked => { root.speed = 1; root.speed-changed(); }
                                    }
                                }
                            }

                            CollapsibleSection {
                                title: "THUMBNAIL";
                                open <=> root.thumbnail-open;
                                toggled => { root.sections-changed(); }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: root.thumbnail-label;
                                        color: Theme.muted;
                                        vertical-alignment: center;
                                    }
                                    if root.thumbnail-pos >= 0: PillButton {
                                        horizontal-stretch: 0;
                                        text: "Reset";
                                        font-size: Theme.font-small;
                                        clicked => { root.reset-thumbnail(); keys.focus(); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    PillButton {
                                        text: "Use frame";
                                        icon: Icons.image;
                                        clicked => { root.set-thumbnail(); keys.focus(); }
                                    }
                                    PillButton {
                                        text: root.saving-thumbnail ? "Saving…" : "Save image";
                                        icon: Icons.export;
                                        enabled: !root.saving-thumbnail;
                                        clicked => { root.save-thumbnail(); keys.focus(); }
                                    }
                                }
                                if root.thumbnail-error != "": Text {
                                    text: root.thumbnail-error;
                                    color: Theme.record;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "MP4 exports carry it as their cover, shown by " + root.file-manager + " and players. Save image writes it as a JPEG.";
                                    color: Theme.faint;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border; }
                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;
                        SectionLabel { text: "EXPORT"; }
                        ComboBox {
                            model: ["MP4 (H.264)", "WebM (VP9)", "WebM (AV1)", "GIF"];
                            current-index <=> root.export-format;
                            enabled: !root.exporting;
                        }
                        ComboBox {
                            model: ["Original size", "1080p", "720p"];
                            current-index <=> root.export-resolution;
                            enabled: !root.exporting && root.export-format != 3;
                        }
                        if root.has-audio && root.export-format != 3: Switch {
                            text: "Reduce background noise";
                            checked <=> root.export-denoise;
                            enabled: !root.exporting;
                        }
                        if root.has-audio && root.export-format != 3: Switch {
                            text: "Even out volume";
                            checked <=> root.export-normalize;
                            enabled: !root.exporting;
                        }
                        if root.exporting: VerticalLayout {
                            spacing: 6px;
                            ProgressIndicator { progress: root.export-progress; }
                            HorizontalLayout {
                                Text { text: root.export-status; color: Theme.muted; font-size: Theme.font-small; vertical-alignment: center; }
                                PillButton { text: "Cancel"; clicked => { root.cancel-export(); } }
                            }
                        }
                        if !root.exporting: PillButton {
                            primary: true;
                            text: "Export";
                            icon: Icons.export;
                            clicked => { root.export(); }
                        }
                        if !root.exporting && root.export-status != "": HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: root.export-status;
                                color: root.export-done ? Theme.success : Theme.record;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                                vertical-alignment: center;
                            }
                            if root.export-done: PillButton {
                                text: "Show";
                                clicked => { root.reveal-export(); }
                            }
                        }
                    }
                }
            }
        }

        // Transport
        Rectangle {
            height: 48px;
            background: Theme.surface;
            border-width: 0;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                IconButton {
                    y: (parent.height - self.height) / 2;
                    size: 36px;
                    icon: root.playing ? Icons.pause : Icons.play;
                    filled: true;
                    tooltip: "Play / pause (Space)";
                    clicked => { root.toggle-play(); keys.focus(); }
                }
                Text {
                    text: root.time-label;
                    color: Theme.text;
                    font-family: "Menlo";
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.active-edge >= 0
                        ? "← → move this edge a frame (⇧ for 10) · Esc to stop"
                        : "Drag on the timeline to select · Drag a cut's edge to adjust it · ← → step";
                    color: Theme.faint;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
            }
        }

        // Timeline
        timeline := Rectangle {
            height: 128px;
            background: Theme.bg;
            property <length> track-x: 14px;
            property <length> track-w: self.width - 28px;

            track := Rectangle {
                x: timeline.track-x;
                y: 12px;
                width: timeline.track-w;
                height: parent.height - 24px;
                border-radius: Theme.radius-small;
                clip: true;
                background: Theme.surface;

                for t in root.thumbs: Image {
                    x: t.start * track.width;
                    y: 0;
                    width: (t.end - t.start) * track.width;
                    height: 64px;
                    source: t.image;
                    image-fit: cover;
                    opacity: 0.85;
                }
                Path {
                    x: 0;
                    y: 66px;
                    width: track.width;
                    height: track.height - 68px;
                    viewbox-width: 1000;
                    viewbox-height: 100;
                    commands: root.wave-path;
                    fill: #5b9cff66;
                    stroke: transparent;
                }

                for c[i] in root.cuts: Rectangle {
                    property <float> start: root.drag-cut == i && !root.drag-end ? root.drag-pos : c.start;
                    property <float> end: root.drag-cut == i && root.drag-end ? root.drag-pos : c.end;
                    x: self.start * track.width;
                    width: max(2px, (self.end - self.start) * track.width);
                    height: track.height;
                    background: #0b0c0ed9;
                    Rectangle {
                        height: 3px;
                        y: 0;
                        background: Theme.record;
                    }
                    Text {
                        text: "cut";
                        color: Theme.faint;
                        font-size: Theme.font-small;
                        visible: parent.width > 40px;
                    }
                }

                if root.has-selection: Rectangle {
                    x: root.sel-start * track.width;
                    width: (root.sel-end - root.sel-start) * track.width;
                    height: track.height;
                    background: #5b9cff33;
                    border-width: 2px;
                    border-color: Theme.accent;
                }

                scrub := TouchArea {
                    mouse-cursor: pointer;
                    property <bool> dragging;
                    property <float> anchor;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            self.dragging = false;
                            self.anchor = max(0, min(1, self.mouse-x / track.width));
                            root.active-edge = -1;
                        }
                        if (event.kind == PointerEventKind.up && !self.dragging) {
                            root.sel-start = -1;
                            root.sel-end = -1;
                            root.selection-changed(-1, -1);
                            root.seek(self.anchor);
                            keys.focus();
                        }
                        if (event.kind == PointerEventKind.up && self.dragging) {
                            root.selection-changed(root.sel-start, root.sel-end);
                            keys.focus();
                        }
                    }
                    moved => {
                        if (abs(self.mouse-x - self.pressed-x) > 4px) { self.dragging = true; }
                        if (self.dragging) {
                            root.sel-start = min(self.anchor, max(0, min(1, self.mouse-x / track.width)));
                            root.sel-end = max(self.anchor, max(0, min(1, self.mouse-x / track.width)));
                        }
                    }
                }

                // Selection edge handles.
                if root.has-selection: Rectangle {
                    x: root.sel-start * track.width - 5px;
                    width: 10px;
                    height: track.height;
                    Rectangle { width: 4px; height: 28px; border-radius: 2px; background: Theme.accent; }
                    TouchArea {
                        mouse-cursor: ew-resize;
                        moved => {
                            root.sel-start = max(0, min(root.sel-end - 0.001, (parent.x + self.mouse-x) / track.width));
                        }
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.up) { root.selection-changed(root.sel-start, root.sel-end); }
                        }
                    }
                }
                if root.has-selection: Rectangle {
                    x: root.sel-end * track.width - 5px;
                    width: 10px;
                    height: track.height;
                    Rectangle { width: 4px; height: 28px; border-radius: 2px; background: Theme.accent; }
                    TouchArea {
                        mouse-cursor: ew-resize;
                        moved => {
                            root.sel-end = min(1, max(root.sel-start + 0.001, (parent.x + self.mouse-x) / track.width));
                        }
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.up) { root.selection-changed(root.sel-start, root.sel-end); }
                        }
                    }
                }

                // Cut edges: drag one to move it, showing the frame under it;
                // or click one and nudge it a frame at a time with ← →.
                for c[i] in root.cuts: CutEdge {
                    visible: c.start > 0;
                    pos: root.drag-cut == i && !root.drag-end ? root.drag-pos : c.start;
                    track-width: track.width;
                    active: root.active-edge == i * 2;
                    grab => { root.grab-edge(i, false, c.start); }
                    drag(f) => { root.drag-edge(max(0, min(c.end, f))); }
                    release(dragged, moved) => { root.release-edge(i, false, dragged, moved); }
                    cancel => { root.cancel-edge(); }
                }
                for c[i] in root.cuts: CutEdge {
                    visible: c.end < 1;
                    end: true;
                    pos: root.drag-cut == i && root.drag-end ? root.drag-pos : c.end;
                    track-width: track.width;
                    active: root.active-edge == i * 2 + 1;
                    grab => { root.grab-edge(i, true, c.end); }
                    drag(f) => { root.drag-edge(max(c.start, min(1, f))); }
                    release(dragged, moved) => { root.release-edge(i, true, dragged, moved); }
                    cancel => { root.cancel-edge(); }
                }

                // Markers: a line with a flag; hover shows the note, click seeks.
                for m in root.markers: Rectangle {
                    x: m.pos * track.width - 1px;
                    width: 2px;
                    height: track.height;
                    background: Theme.accent.transparentize(40%);
                }
                for m in root.markers: Rectangle {
                    x: m.pos * track.width;
                    y: 0;
                    width: 12px;
                    height: 12px;
                    background: Theme.accent;
                    flag := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.seek(m.pos); keys.focus(); }
                    }
                    if flag.has-hover: Rectangle {
                        property <length> w: note.preferred-width + 12px;
                        x: min(0px, track.width - m.pos * track.width - self.w);
                        y: parent.height + 2px;
                        width: self.w;
                        height: 20px;
                        border-radius: 4px;
                        background: #141518f2;
                        note := Text {
                            text: m.label;
                            color: Theme.text;
                            font-size: Theme.font-small;
                        }
                    }
                }

                // Thumbnail frame
                if root.thumbnail-pos >= 0: Rectangle {
                    x: root.thumbnail-pos * track.width - 5px;
                    y: 2px;
                    width: 10px;
                    height: 10px;
                    border-radius: 2px;
                    background: Theme.warning;
                    transform-rotation: 45deg;
                }

                // Playhead
                Rectangle {
                    x: root.position * track.width - 1px;
                    width: 2px;
                    height: track.height;
                    background: white;
                    Rectangle {
                        y: 0;
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: white;
                    }
                }
            }
        }
    }

    // Export finished: the next steps, over the editor.
    if root.export-card: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000a8;
        // Swallow clicks so the editor underneath stays put.
        TouchArea { }

        Card {
            width: 440px;
            height: card-layout.preferred-height;
            background: Theme.surface;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000080;

            card-layout := VerticalLayout {
                padding: 28px;
                padding-top: 30px;
                spacing: 8px;
                alignment: start;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 52px;
                        height: 52px;
                        border-radius: 26px;
                        background: Theme.success.with-alpha(0.15);
                        Glyph { icon: Icons.check; color: Theme.success; width: 28px; height: 28px; }
                    }
                }
                Text {
                    text: "Your video is ready";
                    horizontal-alignment: center;
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.text;
                }
                Text {
                    text: root.export-name;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    color: Theme.text;
                }
                Text {
                    text: root.export-detail;
                    horizontal-alignment: center;
                    color: Theme.muted;
                    font-size: Theme.font-small;
                }

                Rectangle { height: 10px; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    PillButton {
                        primary: true;
                        text: "Show in " + root.file-manager;
                        icon: Icons.folder;
                        clicked => { root.reveal-export(); }
                    }
                    PillButton {
                        text: "Open";
                        icon: Icons.open;
                        clicked => { root.open-export(); }
                    }
                    if root.can-copy: PillButton {
                        text: root.copied ? "Copied" : "Copy";
                        icon: root.copied ? Icons.check : Icons.copy;
                        clicked => { root.copy-export(); }
                    }
                }
                if root.can-copy: Text {
                    text: root.copied
                        ? "Paste it into Messages, Mail, Slack or any app that takes files."
                        : "Copy puts the file on the clipboard, ready to paste into a message.";
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    color: Theme.muted;
                    font-size: Theme.font-small;
                }

                Rectangle { height: 14px; }
                Rectangle { height: 1px; background: Theme.border; }
                Rectangle { height: 6px; }
                HorizontalLayout {
                    spacing: 8px;
                    PillButton {
                        horizontal-stretch: 0;
                        text: "Keep editing";
                        clicked => { root.export-card = false; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    PillButton {
                        horizontal-stretch: 0;
                        text: "Done";
                        icon: Icons.check;
                        clicked => { root.done(); }
                    }
                }
            }
        }
    }
}
